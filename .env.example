# .env の雛形（値は書かない。実際の値は .env に書き、commit しない）
# 開発手順書2-5
GOOGLE_CLOUD_PROJECT=
BQ_LOCATION=asia-northeast1
# Google AI Studio の API キー（請求先のないプロジェクトで作った無料枠のキー）
GEMINI_API_KEY=
GEMINI_MODEL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# 公開URLを1つにそろえる（任意。要望5）。Cloud Runが発行する2つのURLのうち、
# 決めたほうのドメインを入れると、もう一方で開いた要求をそちらへ301で移す。
# ローカルでは空のままでよい（本番のデプロイのときだけ渡す。開発手順書8-1）。
CANONICAL_HOST=
